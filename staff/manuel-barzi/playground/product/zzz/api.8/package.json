  "description": "",
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "chai": "^5.2.0",
    "mocha": "^11.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "com": "file:../com",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
