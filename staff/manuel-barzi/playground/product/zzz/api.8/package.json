{
  "name": "api",
  "version": "0.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "npx tsx --env-file=.env index.ts",
    "inspect": "npx tsx --env-file=.env --inspect-brk index.ts",
    "compile-watch": "npx tsc --lib es2015,dom --noEmit --esModuleInterop --skipLibCheck --watch --strict *.ts **/*.ts",
    "test": "tsx --env-file=.env logic/*.test.ts",
    "test-inspect": "tsx --env-file=.env --inspect-brk logic/*.test.ts",
    "compile-test": "npm run compile && npm run test",
    "populate": "tsx data/populate"
  },
